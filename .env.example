# ─── AI provider (must cost ₹0) ───────────────────────────────────────────────
LLM_PROVIDER=gemini          # gemini | groq
LLM_MODEL=                   # current free-tier Gemini Flash model ID (AI Studio → model list), e.g. gemini-2.5-flash
GEMINI_API_KEY=              # https://aistudio.google.com/apikey
GROQ_API_KEY=                # optional free fallback: https://console.groq.com/keys
GROQ_MODEL=                  # a current Groq model that supports tool use, e.g. openai/gpt-oss-120b

# ─── Database ────────────────────────────────────────────────────────────────
MONGODB_URI=                 # mongodb+srv://... from Atlas → Connect → Drivers
MONGODB_DB=parentbridge

# ─── WhatsApp (optional; without it every message falls back to a preview) ───
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
DEMO_WHATSAPP_TO=            # your own number joined to the Twilio sandbox, e.g. whatsapp:+9198xxxxxxxx

# ─── App ─────────────────────────────────────────────────────────────────────
APP_BASE_URL=http://localhost:3000   # set to the Vercel URL in production

# ─── Optional guardrails (defaults shown) ────────────────────────────────────
AGENT_RUNS_PER_IP_PER_DAY=15
AGENT_RUNS_GLOBAL_PER_DAY=150
LIVE_WHATSAPP_PER_DAY=25
